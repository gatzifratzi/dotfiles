// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// nochmal ueberarbeitet und fast alles, was ein default wert war, mal raus gegickt. Jetzt sollten alles nur werte sein, die ich ueberschrieben habe.
{
    //STANDARD SACHEN

    "diff_view_style": "split",
    "vim_mode": true,
    "restore_on_startup": "last_session",
    "colorize_brackets": true,
    "preferred_line_length": 120,
    "show_wrap_guides": true,
    "soft_wrap": "bounded",
    "lsp_document_colors": "background", // fuer die css farben und so
    "current_line_highlight": "all",
    "when_closing_with_no_tabs": "keep_window_open",
    "cli_default_open_behavior": "new_window",
    "use_system_prompts": false,
    "use_system_path_prompts": false,
    "use_smartcase_search": true,
    "search": {
        "center_on_match": true,
    },
    "vim": {
        "cursor_shape": {
            "visual": "hollow",
        },
        "use_smartcase_find": true,
        "toggle_relative_line_numbers": true,
    },
    "which_key": {
        "enabled": true,
    },
    "sticky_scroll": {
        "enabled": false,
    },

    //VISUELLES
    // Themes (cmd-k cmd-t)
    // Skeletor, Sandstorm Dark: manuell
    // Modus, srcery, ember, gruvbox baby, kanagawa, blade runner
    "theme": {
        "mode": "system",
        "light": "Ember Glass",
        "dark": "Ember Dark",
    },
    "icon_theme": "Catppuccin Macchiato",
    "unnecessary_code_fade": 0.5,

    //Fonts
    "cursor_shape": "bar",
    "agent_ui_font_size": 17,
    "agent_buffer_font_size": 18,
    "ui_font_size": 17,
    "ui_font_family": "Monocraft",
    "buffer_font_size": 18,
    "buffer_font_weight": 500, // default 400
    "buffer_font_family": "jakobsArgon",
    "buffer_line_height": "comfortable",
    "buffer_font_features": {
        //das sind die ligatures und so
        "calt": false,
        "liga": true,
        "ss01": true,
        "ss03": true,
        "ss06": true,
        "ss08": true,
        "ss09": true,
        "ss10": true,
    },
    //comments italic machen (ich wuerde fuer comments sehr gerne eine andere schriftart nutzen, aber das geht nicht)(habe fonts als workaround gemerged)
    "experimental.theme_overrides": {
        "syntax": {
            "comment": {
                "font_style": "italic",
            },
        },
    },

    "indent_guides": {
        "active_line_width": 2,
        "line_width": 1,
        "coloring": "indent_aware",
    },

    //Active Pane Modifiers(split view)
    "active_pane_modifiers": {
        "inactive_opacity": 0.9,
        "border_size": 1,
    },

    //Tabs
    "tabs": {
        "close_position": "right",
        "file_icons": true,
        "git_status": true,
    },

    //Editor Toolbar
    "toolbar": {
        "code_actions": true,
    },

    //titlebar
    "title_bar": {
        "show_branch_status_icon": true,
    },

    //Git
    "git": {
        "git_gutter": "tracked_files",
        "hunk_style": "staged_hollow",
        "branch_picker": {
            "show_author_name": true,
        },
        "inline_blame": {
            "enabled": true,
            "show_commit_summary": false,
            "padding": 8,
        },
        "blame": {
            "show_avatar": true,
        },
    },

    //Wo und wie wird was im UI angezeigt
    "gutter": {
        "min_line_number_digits": 3,
    },
    //git panel
    "git_panel": {
        "file_icons": true,
        "tree_view": true,
        "dock": "left",
        "default_width": 480,
        "sort_by_path": true, //die settings mal bischen testen. ich wiess nicht ob ich die sortierung nach tracked/untracked brauche und dann ist die ja cooler.
    },

    //Project Panel
    "project_panel": {
        "show_diagnostics": "errors",
        "button": true,
        "dock": "left",
        "entry_spacing": "comfortable",
        "default_width": 240,
    },

    //outline Panel
    "outline_panel": {
        "button": true,
        "dock": "left",
        "default_width": 300,
    },

    //collab panel
    "collaboration_panel": {
        "dock": "right",
        "button": true,
    },

    //TERMINAL
    "terminal": {
        "dock": "bottom",
        "button": true,
        "default_height": 480,
        "show_count_badge": true,
        "blinking": "terminal_controlled",
        "cursor_shape": "bar",
        "font_family": "Monaspace Krypton NF",
        "font_size": 17,
        "shell": "system",
        "working_directory": "current_project_directory",
        "minimum_contrast": 30,
    },

    // debugger
    "debugger": {
        "dock": "right",
        "button": true,
        "save_breakpoints": true,
    },

    //Diagnostics (auch inline)
    "diagnostics": {
        "button": true,
        "include_warnings": true,
        "inline": {
            "enabled": true,
            "min_column": 80,
        },
    },

    // KI Agent
    "agent": {
        "flexible": true,
        "favorite_models": [
            {
                "provider": "google",
                "model": "gemini-3-flash-preview",
                "enable_thinking": false,
            },
            {
                "provider": "google",
                "model": "gemini-3.1-pro-preview",
                "enable_thinking": true,
            },
        ],
        "sidebar_side": "right",
        "tool_permissions": {
            "default": "allow",
        },
        "use_modifier_to_send": true,
        "default_profile": "write",
        "enabled": true,
        "button": true,
        "dock": "right",
        "default_model": {
            "provider": "google",
            "model": "gemini-3-flash-preview",
        },
    },
    "agent_servers": {
        "gemini": {
            "default_model": "auto-gemini-3",
            "type": "registry",
        },
    },

    // EDIT PREDICTIONS
    "show_edit_predictions": true,
    "edit_predictions_disabled_in": ["string", "comment"],
    "edit_predictions": {
        "provider": "none", //schaltet die global ab
        "disabled_globs": null,
        "mode": "eager",
        "copilot": {
            "proxy": null,
            "proxy_no_verify": null,
        },
    },

    "inlay_hints": {
        "enabled": true,
        "show_type_hints": true,
        "show_parameter_hints": true,
        "show_other_hints": true,
        "show_background": true,
        "edit_debounce_ms": 0,
        "scroll_debounce_ms": 0,
    },

    //LSPs und Formatierung
    "lsp_highlight_debounce": 50,
    "hover_popover_delay": 80,
    "tab_size": 4,

    "languages": {
        "Haskell": {
            "enable_language_server": true,
            "language_servers": ["hls", "..."],
            "formatter": "language_server",
        },
        "C++": {
            "enable_language_server": true,
            "language_servers": ["clangd", "..."],
            "formatter": "language_server",
            "format_on_save": "on",
            "use_on_type_format": true,
        },
        "Python": {
            "enable_language_server": true,
            "language_servers": ["!pyright", "!pylsp", "basedpyright", "..."],
            "formatter": "prettier",
        },
        "TypeScript": {
            "enable_language_server": true,
            "language_servers": ["!typescript-language-server", "vtsls", "..."],
            "formatter": "prettier",
        },
        "JavaScript": {
            "enable_language_server": true,
            "language_servers": ["!typescript-language-server", "vtsls", "..."],
            "formatter": "prettier",
        },
        "HTML": {
            "enable_language_server": true,
            "language_servers": ["microsoft/vscode-html-languageservice", "..."],
            "formatter": "prettier",
        },
        "CSS": {
            "enable_language_server": true,
            "language_servers": ["tailwindcss-language-server", "..."],
            "formatter": "language_server",
        },
    },

    "lsp": {
        //texlab = latex extension. kein build on save (wegen tectonic)
        "texlab": {
            //actually geht das jetzt auch mit tectonic. ich find meine loesung aber besser
            "settings": {
                "texlab": {
                    "build": {
                        "onSave": false,
                    },
                },
            },
        },
        "ltex": {
            "settings": {
                "ltex": {
                    "language": "de-DE", //sprache von ltex
                    "enabled": ["latex", "bibtex"], //fuer welche sprachen ltex aktiv ist.
                },
            },
        },
    },
}
