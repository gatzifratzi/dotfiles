// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    // --- LATEX KEYBINDS ---
    {
        //"context": "Workspace",
        "context": "Editor && extension==tex", // This restricts the keybindings to tex files however does not work when in terminal
        "bindings": {
            "super-ctrl-v": ["task::Spawn", { "task_name": "forward_search_skim" }],
            "super-ctrl-b": ["task::Spawn", { "task_name": "tectonic_skim" }],
        },
    },
    // --- UNBINDS FUER MACOS WM ---
    {
        "context": "Editor",
        "bindings": {
            // "j k": ["workspace::SendKeystrokes", "escape"]
            "ctrl-alt-h": null, //unbinded, damit macos commands fuer window management funktionieren
            "ctrl-alt-f": null, //unbinded, damit macos commands fuer window management funktionieren
            "ctrl-alt-shift-f": null, //unbinded, damit macos commands fuer window management funktionieren
        },
    },
    //GEMINI CLI
    //wurde neu als ACP implementiert und braucht jetzt andere keybinds. Mach ich irgendwann mal, wenn ich die brauche.

    // --- Multi Cursor ---
    {
        "context": "Editor",
        "bindings": {
            "super-alt-ctrl-shift-p": ["editor::AddSelectionAbove", { "skip_soft_wrap": true }],
            "super-alt-ctrl-shift-n": ["editor::AddSelectionBelow", { "skip_soft_wrap": true }],
        },
    },
    // --- PANES ---
    {
        "context": "Workspace",
        "bindings": {
            "super-alt-ctrl-shift-d d": "pane::SplitRight",
            "super-alt-ctrl-shift-d c": "pane::SplitDown",
            "super-alt-ctrl-shift-l": "workspace::ActivatePaneRight",
            "super-alt-ctrl-shift-k": "workspace::ActivatePaneUp",
            "super-alt-ctrl-shift-j": "workspace::ActivatePaneDown",
            "super-alt-ctrl-shift-h": "workspace::ActivatePaneLeft",
            "super-alt-ctrl-shift-d l": "workspace::SwapPaneRight",
            "super-alt-ctrl-shift-d k": "workspace::SwapPaneUp",
            "super-alt-ctrl-shift-d j": "workspace::SwapPaneDown",
            "super-alt-ctrl-shift-d h": "workspace::SwapPaneLeft",
            "super-alt-ctrl-shift-1": ["workspace::ActivatePane", 0],
            "super-alt-ctrl-shift-2": ["workspace::ActivatePane", 1],
            "super-alt-ctrl-shift-3": ["workspace::ActivatePane", 2],
            "super-alt-ctrl-shift-4": ["workspace::ActivatePane", 3],
            "super-alt-ctrl-shift-5": ["workspace::ActivatePane", 4],
            "super-alt-ctrl-shift-6": ["workspace::ActivatePane", 5],
            "super-alt-ctrl-shift-7": ["workspace::ActivatePane", 6],
            "super-alt-ctrl-shift-8": ["workspace::ActivatePane", 7],
            "super-alt-ctrl-shift-9": ["workspace::ActivatePane", 8],
        },
    },

    /// --- TAB Switching ---
    {
        "context": "Pane",
        "bindings": {
            "super-1": ["pane::ActivateItem", 0],
            "super-2": ["pane::ActivateItem", 1],
            "super-3": ["pane::ActivateItem", 2],
            "super-4": ["pane::ActivateItem", 3],
            "super-5": ["pane::ActivateItem", 4],
            "super-6": ["pane::ActivateItem", 5],
            "super-7": ["pane::ActivateItem", 6],
            "super-8": ["pane::ActivateItem", 7],
            "super-9": ["pane::ActivateItem", 8],
            "super-alt-ctrl-shift-]": "pane::ActivateNextItem",
            "super-alt-ctrl-shift-[": "pane::ActivatePreviousItem",
            "super-alt-ctrl-shift-d [": "pane::SwapItemLeft",
            "super-alt-ctrl-shift-d ]": "pane::SwapItemRight",
        },
    },

    // --- NAVIGATION ---
    {
        "context": "Workspace",
        "bindings": {
            "super-e": "workspace::ToggleLeftDock",
            "super-shift-e": "project_panel::ToggleFocus",
            "super-shift-b": "outline_panel::ToggleFocus",
            //"cjmd-u": "multi_workspace::ToggleWorkspaceSidebar",
            // checke nicht warum der nicht geht
        },
    },
    // cmd-e und cmd-b default rollen getauscht
    {
        "context": "(Editor && mode == full)",
        "bindings": {
            "super-b": [
                "buffer_search::Deploy",
                {
                    "focus": false,
                },
            ],
            "super-e": "workspace::ToggleLeftDock",
            "super-shift-e": "project_panel::ToggleFocus",
        },
    },
    {
        "context": "AgentPanel",
        "bindings": {
            "super-shift-e": "project_panel::ToggleFocus",
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            "super-alt-ctrl-shift-r": "agent::ToggleFocus",
            "super-alt-ctrl-shift-y": "collab_panel::ToggleFocus",
            "super-alt-ctrl-shift-t": "terminal_panel::Toggle",
            "super-alt-ctrl-shift-g": "git_panel::ToggleFocus",
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            "super-alt-ctrl-shift-w": "multi_workspace::ToggleWorkspaceSidebar"
        }
    },
    {
        "context": "Workspace",
        "unbind": { //unbinded die default keybinds
            "alt-super-j": "multi_workspace::ToggleWorkspaceSidebar"
        }
    }
]
